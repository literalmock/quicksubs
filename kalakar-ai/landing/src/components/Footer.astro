---
<footer class="border-t border-surface-800 py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <h3 class="text-xl font-bold bg-gradient-to-r from-primary-400 to-primary-600 bg-clip-text text-transparent mb-3">
          QuickSubs
        </h3>
        <p class="text-surface-500 text-sm max-w-sm leading-relaxed">
          AI-powered video captioning platform. Upload your videos and let AI do the rest.
          Professional subtitles in minutes, not hours.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold text-surface-300 uppercase tracking-wider mb-4">Product</h4>
        <ul class="space-y-2">
          <li><a href="#how-it-works" class="text-sm text-surface-500 hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#pricing" class="text-sm text-surface-500 hover:text-white transition-colors">Pricing</a></li>
          <li><a href="#demo" class="text-sm text-surface-500 hover:text-white transition-colors">Demo</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold text-surface-300 uppercase tracking-wider mb-4">Connect</h4>
        <ul class="space-y-2">
          <li><a href="#" class="text-sm text-surface-500 hover:text-white transition-colors">Twitter</a></li>
          <li><a href="#" class="text-sm text-surface-500 hover:text-white transition-colors">GitHub</a></li>
          <li><a href="#" class="text-sm text-surface-500 hover:text-white transition-colors">Discord</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-surface-800 pt-8 text-center">
      <p class="text-sm text-surface-600">
        &copy; {new Date().getFullYear()} QuickSubs. All rights reserved.
      </p>
    </div>
  </div>
</footer>
