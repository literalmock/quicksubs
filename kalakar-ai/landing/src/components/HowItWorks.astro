---
const steps = [
  {
    icon: '⬆️',
    title: 'Upload Your Video',
    description: 'Drag and drop or select any video file. We support MP4, MOV, AVI, MKV, and WebM formats up to 200MB.',
    color: 'from-blue-500 to-blue-600',
    bgColor: 'bg-blue-500/10',
  },
  {
    icon: '🧠',
    title: 'AI Transcription',
    description: 'Our AI powered by OpenAI Whisper analyzes the audio, transcribes speech, and generates precise subtitles with timestamps.',
    color: 'from-purple-500 to-purple-600',
    bgColor: 'bg-purple-500/10',
  },
  {
    icon: '🎬',
    title: 'Download Result',
    description: 'Get your video with professional subtitles burned in. Ready for social media, YouTube, or any platform.',
    color: 'from-green-500 to-green-600',
    bgColor: 'bg-green-500/10',
  },
];
---

<section id="how-it-works" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-primary-400 text-sm font-medium uppercase tracking-widest mb-3">How It Works</p>
      <h2 class="text-4xl md:text-5xl font-bold">
        Three simple steps to
        <span class="bg-gradient-to-r from-primary-400 to-primary-600 bg-clip-text text-transparent">captioned videos</span>
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {steps.map((step, i) => (
        <div class="relative group">
          {/* Step number */}
          <div class="absolute -top-4 -left-2 text-7xl font-black text-surface-800/50 select-none group-hover:text-surface-700/50 transition-colors">
            {String(i + 1).padStart(2, '0')}
          </div>
          <div class="relative bg-surface-900/80 border border-surface-700 rounded-2xl p-8 hover:border-surface-600 transition-all duration-300 hover:-translate-y-1">
            <div class={`w-14 h-14 rounded-2xl ${step.bgColor} flex items-center justify-center text-2xl mb-6`}>
              {step.icon}
            </div>
            <h3 class="text-lg font-semibold mb-3">{step.title}</h3>
            <p class="text-surface-400 text-sm leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
