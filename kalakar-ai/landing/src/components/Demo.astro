---
---
<section id="demo" class="py-24 relative">
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary-600/10 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-primary-400 text-sm font-medium uppercase tracking-widest mb-3">See It In Action</p>
      <h2 class="text-4xl md:text-5xl font-bold">
        Before & After
      </h2>
      <p class="text-surface-400 text-lg mt-4 max-w-xl mx-auto">
        Watch how QuickSubs transforms your raw video into a professionally captioned masterpiece.
      </p>
    </div>

    <!-- Before/After comparison -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Before -->
      <div class="bg-surface-900 border border-surface-700 rounded-2xl overflow-hidden">
        <div class="px-4 py-3 border-b border-surface-700 flex items-center justify-between">
          <span class="text-sm font-medium text-surface-400">Before</span>
          <span class="px-3 py-1 rounded-full bg-surface-700 text-surface-400 text-xs">Original</span>
        </div>
        <div class="aspect-video bg-surface-800 flex items-center justify-center">
          <div class="text-center">
            <span class="text-5xl mb-3 block">🎥</span>
            <p class="text-surface-500 text-sm">Raw video without captions</p>
            <div class="mt-4 flex justify-center gap-1">
              <div class="w-12 h-1 bg-surface-600 rounded-full"></div>
              <div class="w-8 h-1 bg-surface-600 rounded-full"></div>
              <div class="w-16 h-1 bg-surface-600 rounded-full"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- After -->
      <div class="bg-surface-900 border border-primary-500/30 rounded-2xl overflow-hidden shadow-lg shadow-primary-600/5">
        <div class="px-4 py-3 border-b border-primary-500/30 flex items-center justify-between">
          <span class="text-sm font-medium text-primary-400">After</span>
          <span class="px-3 py-1 rounded-full bg-primary-500/20 text-primary-400 text-xs">AI Captioned</span>
        </div>
        <div class="aspect-video bg-surface-800 flex items-center justify-center relative">
          <div class="text-center">
            <span class="text-5xl mb-3 block">✨</span>
            <p class="text-surface-300 text-sm">Video with burned-in captions</p>
          </div>
          <!-- Simulated subtitle -->
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2">
            <div class="bg-black/70 px-6 py-2 rounded-lg backdrop-blur-sm">
              <p class="text-white text-sm font-medium">"Transform your videos with AI captions"</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Features list -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
      {[
        { icon: '🌍', label: '50+ Languages' },
        { icon: '⚡', label: 'Fast Processing' },
        { icon: '🎯', label: '99% Accuracy' },
        { icon: '📱', label: 'Any Platform' },
      ].map((feature) => (
        <div class="text-center p-4">
          <span class="text-2xl block mb-2">{feature.icon}</span>
          <p class="text-sm text-surface-300 font-medium">{feature.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
