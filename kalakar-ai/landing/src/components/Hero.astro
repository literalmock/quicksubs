---
---
<section class="relative pt-32 pb-24 overflow-hidden">
  <!-- Background glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-primary-600/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary-500/30 bg-primary-500/10 text-primary-400 text-sm font-medium mb-8">
      <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
      Powered by OpenAI Whisper
    </div>

    <!-- Headline -->
    <h1 class="text-5xl md:text-7xl font-extrabold leading-tight tracking-tight mb-6">
      Auto-Generate
      <span class="bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600 bg-clip-text text-transparent">
        Video Captions
      </span>
      <br />with AI
    </h1>

    <!-- Subtitle -->
    <p class="max-w-2xl mx-auto text-lg md:text-xl text-surface-400 leading-relaxed mb-10">
      Upload your video and let our AI automatically transcribe, generate subtitles,
      and burn them right into your video. No manual editing required.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="http://localhost:5173/signup"
        class="px-8 py-4 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white font-semibold rounded-2xl text-lg transition-all duration-300 shadow-lg shadow-primary-600/25 hover:shadow-primary-500/40 hover:scale-105"
      >
        Start for Free →
      </a>
      <a
        href="#demo"
        class="px-8 py-4 border border-surface-600 hover:border-surface-500 text-surface-300 hover:text-white font-medium rounded-2xl text-lg transition-all duration-300 hover:bg-surface-800/50"
      >
        See Demo
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-20 grid grid-cols-3 gap-8 max-w-lg mx-auto">
      <div>
        <p class="text-3xl font-bold text-white">10K+</p>
        <p class="text-sm text-surface-500">Videos Processed</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-white">50+</p>
        <p class="text-sm text-surface-500">Languages</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-white">99%</p>
        <p class="text-sm text-surface-500">Accuracy</p>
      </div>
    </div>

    <!-- Hero visual -->
    <div class="mt-16 relative mx-auto max-w-4xl">
      <div class="absolute inset-0 bg-gradient-to-t from-surface-950 via-transparent to-transparent z-10 pointer-events-none"></div>
      <div class="rounded-2xl border border-surface-700 bg-surface-900 overflow-hidden shadow-2xl shadow-primary-600/5">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-surface-700">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          <span class="ml-3 text-xs text-surface-500">QuickSubs Dashboard</span>
        </div>
        <div class="p-8">
          <div class="flex items-center gap-6">
            <div class="flex-1 border-2 border-dashed border-surface-600 rounded-xl p-8 text-center">
              <span class="text-4xl mb-3 block">🎥</span>
              <p class="text-sm text-surface-400">Drag & drop your video here</p>
              <p class="text-xs text-surface-600 mt-1">MP4, MOV, AVI up to 200MB</p>
            </div>
            <div class="hidden md:flex flex-col gap-4 text-sm">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-green-500/20 text-green-400 flex items-center justify-center text-sm">✓</span>
                <span class="text-surface-300">Upload complete</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center text-sm">
                  <span class="animate-spin inline-block">⟳</span>
                </span>
                <span class="text-surface-300">AI transcribing…</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-surface-700 text-surface-500 flex items-center justify-center text-sm">3</span>
                <span class="text-surface-500">Download captioned video</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
