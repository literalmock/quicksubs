# Worker Environment Variables
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kalakar?retryWrites=true&w=majority

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Transcription Provider: "groq" or "local"
TRANSCRIPTION_PROVIDER=groq

# Groq (when TRANSCRIPTION_PROVIDER=groq)
GROQ_API_KEY=gsk-your-groq-api-key

# Local Faster-Whisper (when TRANSCRIPTION_PROVIDER=local)
LOCAL_WHISPER_URL=http://localhost:8787
WHISPER_MODEL=small

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
