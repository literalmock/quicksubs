# Worker Environment Variables
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kalakar?retryWrites=true&w=majority

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Groq (Whisper transcription — default provider)
GROQ_API_KEY=gsk-your-groq-api-key

# ElevenLabs (Scribe v2 STT — alternative provider for retranscribe)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Hinglish verification gate
# Preferred LLM processors for Hinglish verification:
# HINGLISH_VERIFIER_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# or
# HINGLISH_VERIFIER_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional model override:
# HINGLISH_VERIFIER_MODEL=gemini-2.5-pro
# If your DeepSeek account exposes a v3.2 model id, set it here instead.
# HINGLISH_MIN_AVG_CONFIDENCE=0.86
# HINGLISH_MAX_LOW_CONFIDENCE_CAPTIONS=1

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
