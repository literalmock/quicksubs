# Worker Environment Variables
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kalakar?retryWrites=true&w=majority

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Groq (Whisper transcription — default provider)
GROQ_API_KEY=gsk-your-groq-api-key

# ElevenLabs (Scribe v2 STT — alternative provider for retranscribe)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Caption refinement (optional)
# Set to "none" to skip any LLM refinement and keep raw ASR captions.
# REFINEMENT_PROVIDER=groq
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

